# ---- Auth ------------------------------------------------------------------
# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Data backend ----------------------------------------------------------
# "memory" = local JSON file (default, no Google setup needed)
# "sheets" = Google Sheets (production)
CRM_DATA_BACKEND=memory

# Where the memory backend keeps its data.
MEMORY_DB_PATH=.data/crm.json

# Business timezone for agent call history, date filters, exports and daily totals.
CRM_TIME_ZONE=Asia/Karachi

# ---- Google Sheets (only needed when CRM_DATA_BACKEND=sheets) --------------
# The spreadsheet ID: the long string in the sheet URL between /d/ and /edit
SHEET_ID=

# From the service account JSON you download from Google Cloud Console.
GOOGLE_CLIENT_EMAIL=crm-service-account@your-project.iam.gserviceaccount.com

# The private key, with literal \n where the newlines were.
# In a .env file, wrap the value in double quotes so the newlines survive.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"

# ---- Tuning ----------------------------------------------------------------
# How long a claimed lead stays locked before another agent can take it.
LOCK_TTL_SECONDS=300

# How long a claim waits before checking whether it won the race.
LOCK_SETTLE_MS=1200

# How long a cached read of the Leads tab is reused.
SHEET_CACHE_TTL_MS=5000
